# dependencies
node_modules/
**/node_modules/

# build output (plugins that ship TypeScript keep source only)
**/dist/
**/lib/
*.tsbuildinfo

# archived plugin snapshots: their bundled lib/ is historical source, keep it
!archive/**/lib/

# lockfiles (profile-managed, not part of the plugin source)
**/pnpm-lock.yaml
package-lock.json

# os / editor
.DS_Store
*.log

# dsh runtime data / regenerable caches / session artifacts (not source)
.dsh-meow/
.npm-cache/
.npm-cache-redirect/
.run-*.log.zip
.dshkf-*

# external reference clone (deepseek harness docs), not part of this repo
deepseek-harness-docs/
